{
  "name": "@october-dev/moirai",
  "version": "0.1.1",
  "description": "Typed canonical session model and portable transcript tools for Moirai.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/moirai.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/october-dev/moirai#readme",
  "bugs": {
    "url": "https://github.com/october-dev/moirai/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "sessions",
    "checkpoints",
    "interoperability"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
