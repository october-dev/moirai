{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/october-dev/moirai/raw/main/schema/moirai-session.schema.json",
  "title": "Moirai Session",
  "type": "object",
  "required": ["schema_version", "meta", "messages"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "meta": { "$ref": "#/$defs/metadata" },
    "messages": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/message" }
    },
    "extra": true
  },
  "additionalProperties": false,
  "$defs": {
    "rfc3339": { "type": "string", "format": "date-time" },
    "format": {
      "enum": [
        "simple", "claude_code", "codex", "pi", "amp", "opencode",
        "cursor", "cursor_desktop", "grok", "hermes", "antigravity",
        "campfire", "cowork", "fx", "claude_chat", "chatgpt"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_format": { "$ref": "#/$defs/format" },
        "source_session_id": { "type": "string" },
        "imported_at": { "$ref": "#/$defs/rfc3339" },
        "parent_session_id": { "type": "string" },
        "parent_checkpoint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timestamp": { "$ref": "#/$defs/rfc3339" },
        "updated_at": { "$ref": "#/$defs/rfc3339" },
        "cwd": { "type": "string" },
        "git_branch": { "type": "string" },
        "title": { "type": "string" },
        "model": { "type": "string" },
        "cli_version": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "extra": true
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string" },
        "data": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "media_type": { "type": "string" },
        "source": { "$ref": "#/$defs/media" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": { "type": { "const": "text" }, "text": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "thinking" },
            "text": { "type": "string", "minLength": 1 },
            "signature": { "type": "string" },
            "encrypted": { "type": "string", "minLength": 1 }
          },
          "anyOf": [{ "required": ["text"] }, { "required": ["encrypted"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "id", "name"],
          "properties": {
            "type": { "const": "tool_use" },
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "input": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "tool_result" },
            "tool_use_id": { "type": "string" },
            "content": true,
            "is_error": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "source"],
          "properties": { "type": { "const": "image" }, "source": { "$ref": "#/$defs/media" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "artifact"],
          "properties": { "type": { "const": "artifact" }, "artifact": { "$ref": "#/$defs/artifact" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": { "type": { "const": "unknown" }, "data": true },
          "additionalProperties": false
        }
      ]
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["user", "assistant"] },
        "content": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "timestamp": { "$ref": "#/$defs/rfc3339" },
        "model": { "type": "string" },
        "usage": { "$ref": "#/$defs/usage" },
        "stop_reason": { "type": "string" },
        "extra": true
      },
      "additionalProperties": false
    }
  }
}
